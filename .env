# Nagar Connect Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Database configuration (SQLite for local zero-config, or PostgreSQL: postgresql://user:password@localhost:5432/nagar_connect)
DATABASE_URL="file:./nagar_connect.db"

# JWT Authentication Secret & Expiration
JWT_SECRET="nagar_connect_civic_jwt_secret_dev_key_2026_secure"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CLIENT_ORIGIN="http://localhost:5173"
